<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="ResourceBase">
    <defName>BetterRaids_CrudeJailbreaker</defName>
    <label>crude jailbreaker</label>
    <description>A crude protocol-breaking device for disabling BetterRaids implant kill-switches. It is cheap and unreliable, but can be produced with industrial machining.</description>
    <graphicData>
      <texPath>Things/Item/Jailbreakers/CrudeJailbreaker</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.85</drawSize>
    </graphicData>
    <techLevel>Industrial</techLevel>
    <stackLimit>1</stackLimit>
    <statBases>
      <MarketValue>410</MarketValue>
      <Mass>0.35</Mass>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToMake>6500</WorkToMake>
      <Flammability>1.0</Flammability>
    </statBases>
    <costList>
      <ComponentIndustrial>5</ComponentIndustrial>
      <Steel>70</Steel>
      <Silver>90</Silver>
    </costList>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Smith</soundWorking>
      <recipeUsers>
        <li>TableMachining</li>
        <li>FabricationBench</li>
      </recipeUsers>
      <skillRequirements>
        <Crafting>5</Crafting>
      </skillRequirements>
      <researchPrerequisite>BetterRaids_CrudeJailbreakerResearch</researchPrerequisite>
      <unfinishedThingDef>UnfinishedTechItem</unfinishedThingDef>
    </recipeMaker>
  </ThingDef>

