<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <RecipeDef ParentName="SurgeryFlesh">
    <defName>BetterRaids_DisableProtocolCrude</defName>
    <label>disable kill-switch protocol (crude jailbreaker)</label>
    <description>Attempt to disable an armed BetterRaids implant kill-switch protocol using a crude jailbreaker. Failure activates the protocol.</description>
    <workerClass>BetterRaids.Recipe_DisableProtocolWithJailbreaker</workerClass>
    <jobString>Disabling kill-switch protocol.</jobString>
    <workAmount>4500</workAmount>
    <isViolation>true</isViolation>
    <anesthetize>true</anesthetize>
    <recipeUsers>
      <li>Human</li>
      <li MayRequire="Ludeon.RimWorld.Anomaly">CreepJoiner</li>
    </recipeUsers>
    <skillRequirements>
      <Medicine>5</Medicine>
    </skillRequirements>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>BetterRaids_CrudeJailbreaker</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MedicineIndustrial</li>
            <li>MedicineUltratech</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>BetterRaids_CrudeJailbreaker</li>
        <li>MedicineIndustrial</li>
        <li>MedicineUltratech</li>
      </thingDefs>
    </fixedIngredientFilter>
    <appliedOnFixedBodyParts>
      <li>Torso</li>
    </appliedOnFixedBodyParts>
  </RecipeDef>

